# Copia in .env e riempi con i valori del tuo progetto Firebase.
# Il .env vero non va in git (escluso dal .gitignore).
#
# Attenzione: Vite incorpora le VITE_* nel bundle durante la build, quindi
# finiscono nel JavaScript servito al browser. Non sono segreti e non vanno
# usate per niente che debba restare tale. La chiave web di Firebase e' pubblica
# per progetto: a proteggere l'account sono gli authorized domains e le regole.

# Radice dell'API. In locale il backend risponde sulla 8080 senza prefisso;
# in produzione vale https://dominio/api (Caddy smista /api al backend).
VITE_API_BASE_URL=http://localhost:8080

# Firebase Authentication. I valori si trovano in
# Console Firebase -> Impostazioni progetto -> Le tue app -> App web.
# VITE_FIREBASE_PROJECT_ID deve combaciare con FIREBASE_PROJECT_ID del backend,
# altrimenti la validazione dell'audience del token fallisce.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
